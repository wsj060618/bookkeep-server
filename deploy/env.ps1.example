# 复制本文件为 env.ps1 后按本机情况修改。env.ps1 不进版本库（含数据库密码）。

$env:DB_USER = 'root'
$env:DB_PWD  = '请填写数据库密码'

# HS256 至少 32 字节；换值等于让已签发的 token 全部失效
$env:JWT_SECRET = '请换成随机字符串-至少32个字符-不要用默认值'

# mysql.exe / mysqldump.exe 所在目录（不含 \bin）
$env:MYSQL_HOME = 'D:\Program Files\MySQL\MySQL Server 8.4'

# 后端 java 与前端 dist 的位置；换机器只改这两行
$env:JAVA_EXE      = 'java'
$env:FRONTEND_DIST = 'D:\coding\bookkeep-web\dist'