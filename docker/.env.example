# 复制为 .env 后填写；.env 已在根 .gitignore 里
# 必填项用 ${VAR:?} 声明了，缺了 compose 会直接报错，不会带着空密钥启动

# MySQL
MYSQL_ROOT_PASSWORD=换成随机强密码
DB_PWD=换成另一个随机密码

# JWT：≥32 字符随机串；prod profile 下若还是仓库默认值，应用会拒绝启动
JWT_SECRET=换成至少32字符的随机串-不要用默认值-0123456789
JWT_EXPIRE=86400

# 找回密码（QQ 邮箱 SMTP；不配则 forgot-password 返回成功但不发信）
MAIL_USERNAME=
MAIL_PASSWORD=
# 发件地址：只放纯地址，必须与 MAIL_USERNAME 一致
MAIL_FROM=
# 发件人显示名：收件人看到的名字，默认项目名
MAIL_FROM_NAME=bookkeep

# 邮件里重置链接的地址，必须是公网可访问的 HTTPS 域名
# 邮件里链接的地址。**没有域名时填 http://你的服务器IP**（找回密码的链接走这个）`r`nAPP_BASE_URL=http://47.100.x.x

# 前端 dist 所在目录（相对 docker/ 或绝对路径）
FRONTEND_DIST=../bookkeep-web/dist

# 票据图片在容器里的落盘目录（compose 已挂命名卷 receipts_data 到这里，一般不用改）
# 备份时别只 dump 数据库：docker compose exec app tar czf - -C /app/data receipts > receipts.tgz
RECEIPT_DIR=/app/data/receipts

# nginx 配置：默认纯 HTTP（裸 IP 访问）；有备案域名/境外服务器时改成 ./nginx.tls.conf 并放好 certs
NGINX_CONF=./nginx.conf
